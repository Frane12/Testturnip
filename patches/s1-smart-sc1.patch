diff --git a/src/freedreno/vulkan/frane_sc.h b/src/freedreno/vulkan/frane_sc.h
new file mode 100644
index 0000000..d544b78
--- /dev/null
+++ b/src/freedreno/vulkan/frane_sc.h
@@ -0,0 +1,83 @@
+#ifndef FRANE_SC_H
+#define FRANE_SC_H
+
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+struct frane_sc_compile_gate {
+   static constexpr unsigned slots_count = 32;
+   static constexpr unsigned key_size = 32;
+   struct slot {
+      std::mutex mutex;
+      std::condition_variable condition;
+      bool busy = false;
+      const void *cache = nullptr;
+      unsigned domain = 0;
+      unsigned char key[key_size] {};
+      std::thread::id owner;
+   } slots[slots_count];
+
+   static unsigned index(const void *cache, const unsigned char *key,
+                         unsigned domain)
+   {
+      uint32_t h;
+      std::memcpy(&h, key, sizeof(h));
+      return (h ^ (uintptr_t(cache) >> 4) ^ domain) & (slots_count - 1);
+   }
+};
+
+class frane_sc_compile_guard {
+   frane_sc_compile_gate::slot *held = nullptr;
+public:
+   frane_sc_compile_guard() = default;
+   frane_sc_compile_guard(const frane_sc_compile_guard &) = delete;
+   frane_sc_compile_guard &operator=(const frane_sc_compile_guard &) = delete;
+   ~frane_sc_compile_guard() { release(); }
+
+   bool acquire(frane_sc_compile_gate *gate, const void *cache,
+                const unsigned char *key, unsigned domain)
+   {
+      if (!gate) return false;
+      auto &s = gate->slots[frane_sc_compile_gate::index(cache, key, domain)];
+      std::unique_lock<std::mutex> lock(s.mutex);
+      while (s.busy) {
+         if (s.cache != cache || s.domain != domain ||
+             std::memcmp(s.key, key, sizeof(s.key)) != 0 ||
+             s.owner == std::this_thread::get_id())
+            return false;
+         s.condition.wait(lock);
+      }
+      s.cache = cache;
+      s.domain = domain;
+      std::memcpy(s.key, key, sizeof(s.key));
+      s.owner = std::this_thread::get_id();
+      s.busy = true;
+      held = &s;
+      return true;
+   }
+
+   void release()
+   {
+      if (!held) return;
+      auto *s = held;
+      {
+         std::lock_guard<std::mutex> lock(s->mutex);
+         s->busy = false;
+      }
+      held = nullptr;
+      s->condition.notify_all();
+   }
+};
+
+static inline bool frane_sc_watch_admit(uint32_t &used, bool paired)
+{
+   if (paired) return true;
+   if (used >= 4) return false;
+   ++used;
+   return true;
+}
+
+#endif
