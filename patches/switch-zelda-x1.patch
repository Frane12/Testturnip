diff --git a/src/freedreno/vulkan/frane_switch_policy.h b/src/freedreno/vulkan/frane_switch_policy.h
new file mode 100644
--- /dev/null
+++ b/src/freedreno/vulkan/frane_switch_policy.h
@@ -0,0 +1,45 @@
+#ifndef FRANE_SWITCH_POLICY_H
+#define FRANE_SWITCH_POLICY_H
+#include <cstdint>
+#include <array>
+
+static inline uint32_t
+frane_switch_draw_band(uint32_t draws)
+{
+   if (draws < 5) return draws;
+   if (draws < 16) return 5;
+   if (draws < 64) return 6;
+   if (draws < 256) return 7;
+   return 8;
+}
+
+static inline std::array<uint32_t, 6>
+frane_switch_area_key(int32_t x, int32_t y, uint32_t width,
+                      uint32_t height, uint32_t draws, uint32_t subpasses)
+{
+   return {uint32_t(x), uint32_t(y), width, height,
+           frane_switch_draw_band(draws), subpasses};
+}
+
+struct frane_switch_small_input {
+   bool enabled = false;
+   bool profiled_one_time = false;
+   bool safe_full_frame = false;
+   bool depth_or_mrt = false;
+   uint32_t draws = 0;
+   uint64_t pixels = 0;
+   uint64_t tiles = 0;
+   uint64_t resident_cpp = 0;
+   uint64_t transfer_cpp = 0;
+};
+
+static inline bool
+frane_switch_tune_small(const frane_switch_small_input &in)
+{
+   return in.enabled && in.profiled_one_time && in.safe_full_frame &&
+          in.depth_or_mrt && in.draws >= 2 && in.draws <= 4 &&
+          in.pixels >= UINT64_C(262144) &&
+          in.tiles >= 1 && in.tiles <= 16 &&
+          in.resident_cpp && in.transfer_cpp <= in.resident_cpp;
+}
+#endif
