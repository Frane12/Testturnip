diff --git a/src/freedreno/vulkan/frane_a830_qp1.h b/src/freedreno/vulkan/frane_a830_qp1.h
new file mode 100644
--- /dev/null
+++ b/src/freedreno/vulkan/frane_a830_qp1.h
@@ -0,0 +1,42 @@
+#ifndef FRANE_A830_QP1_H
+#define FRANE_A830_QP1_H
+
+#include <cstdint>
+
+static inline uint32_t
+frane_a830_qp1_add(uint32_t current, uint64_t amount)
+{
+   return current >= 4096 || amount >= 4096 - current
+      ? 4096u : current + uint32_t(amount);
+}
+
+struct frane_a830_qp1_input {
+   uint32_t draws = 0;
+   uint32_t vertices = 0;
+   uint32_t tiles = 0;
+   bool blocked = true;
+};
+
+static inline bool
+frane_a830_qp1_skip_binning(const frane_a830_qp1_input &in)
+{
+   return !in.blocked && in.draws && in.draws <= 16 &&
+          in.vertices && in.vertices <= 192 &&
+          in.tiles >= 3 && in.tiles <= 16 &&
+          uint64_t(in.vertices) * in.tiles <= 2048;
+}
+
+static inline bool
+frane_a830_qp1_tune_small(const frane_a830_qp1_input &in,
+                          uint64_t pixels, uint32_t gmem_cpp,
+                          uint32_t draw_cpp)
+{
+   return !in.blocked && in.draws >= 2 && in.draws <= 4 &&
+          in.vertices && in.vertices <= 192 &&
+          in.tiles && in.tiles <= 16 &&
+          pixels >= 262144 && pixels <= 2097152 &&
+          gmem_cpp && gmem_cpp <= 32 &&
+          uint64_t(draw_cpp) >= uint64_t(gmem_cpp) * 2;
+}
+
+#endif
