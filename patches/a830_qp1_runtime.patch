+bool
+frane_a830_qp1_enabled(const struct tu_device *device)
+{
+   static const bool enabled = debug_get_bool_option("TU_FRANE_A830_QP1", true);
+   return enabled && frane_a830_target(device->physical_device->dev_id.chip_id);
+}
+
+frane_a830_qp1_input
+frane_a830_qp1_get_input(const struct tu_cmd_buffer *cmd)
+{
+   frane_a830_qp1_input in {};
+   const auto &rp = cmd->state.rp;
+   const auto *pass = cmd->state.pass;
+   const auto *tiling = cmd->state.tiling;
+   const auto *fb = cmd->state.framebuffer;
+   if (!pass || !tiling || !fb || !tiling->possible)
+      return in;
+   in.draws = rp.drawcall_count;
+   in.vertices = rp.frane_qp1_vertices;
+   const uint64_t tiles = uint64_t(tiling->vsc.tile_count.width) *
+                           tiling->vsc.tile_count.height;
+   in.tiles = tiles > UINT32_MAX ? UINT32_MAX : uint32_t(tiles);
+   in.blocked = !frane_a830_qp1_enabled(cmd->device) ||
+      rp.frane_qp1_unknown || rp.has_tess || rp.xfb_used ||
+      rp.has_prim_generated_query_in_rp || rp.has_vtx_stats_query_in_rp ||
+      rp.has_zpass_done_sample_count_write_in_rp ||
+      cmd->state.xfb_query_running_before_rp ||
+      cmd->state.prim_generated_query_running_before_rp ||
+      cmd->state.vtx_stats_query_running_before_rp ||
+      cmd->state.prim_counters_running || rp.draw_cs_writes_to_cond_pred ||
+      pass->has_fdm || pass->has_msrtss || pass->num_views > 1 ||
+      fb->layers != 1 || cmd->state.per_layer_render_area ||
+      pass->subpass_count != 1 || pass->subpasses[0].depth_used ||
+      pass->subpasses[0].stencil_used ||
+      TU_DEBUG(FORCEBIN) || TU_DEBUG(NOBIN) ||
+      TU_DEBUG(FORCE_CONCURRENT_BINNING);
+   return in;
+}
