+   if (best) {
+      best->first_subpass = MIN2(best->first_subpass, first_subpass);
+      best->last_subpass = MAX2(best->last_subpass, last_subpass);
+      return best;
+   }
+
+   best = &allocs[(*num_allocs)++];
+   best->cpp = cpp;
+   best->first_subpass = first_subpass;
+   best->last_subpass = last_subpass;
+   return best;
+}
