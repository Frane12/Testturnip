+static uint32_t
+frane_a810_gmem_profile(void)
+{
+   static const uint32_t profile = []() {
+      const char *env = os_get_option("TU_A810_GMEM_PROFILE");
+      if (env && strcmp(env, "0") == 0)
+         return 0u;
+      if (env && strcmp(env, "2") == 0)
+         return 2u;
+      /* V15-Q: A810 bounded GMEM experiment; profile 0 restores V15-P
+       * for a reliable SYSMEM-first image/texture baseline.
+       */
+      return 1u;
+   }();
+   return profile;
