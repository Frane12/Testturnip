diff --git a/src/freedreno/vulkan/frane_ds1.h b/src/freedreno/vulkan/frane_ds1.h
new file mode 100644
--- /dev/null
+++ b/src/freedreno/vulkan/frane_ds1.h
@@ -0,0 +1,98 @@
+#ifndef FRANE_DS1_H
+#define FRANE_DS1_H
+#include <cstdint>
+
+enum frane_ds1_kind : uint8_t {
+   FRANE_DS1_COLOR, FRANE_DS1_DEPTH, FRANE_DS1_PACKED,
+   FRANE_DS1_SPLIT, FRANE_DS1_STENCIL, FRANE_DS1_UNKNOWN
+};
+enum : uint8_t { FRANE_DS1_D = 1, FRANE_DS1_S = 2 };
+enum : uint8_t {
+   FRANE_DS1_HAS_DEPTH = 1, FRANE_DS1_HAS_STENCIL = 2,
+   FRANE_DS1_HAS_PACKED = 4, FRANE_DS1_PERSISTENT = 8,
+   FRANE_DS1_STENCIL_LS = 16
+};
+struct frane_ds1_ops {
+   uint8_t load = 0, store = 0, clear = 0, preserve = 0;
+   bool known = false;
+};
+struct frane_ds1_emitted {
+   bool load = false, store = false;
+   bool load_stencil = false, store_stencil = false;
+   uint8_t clear = 0;
+};
+struct frane_ds1_plane {
+   int32_t offset = -1;
+   uint32_t cpp = 0;
+};
+static inline uint8_t frane_ds1_aspects(frane_ds1_kind kind)
+{
+   return kind == FRANE_DS1_DEPTH ? FRANE_DS1_D :
+          kind == FRANE_DS1_STENCIL ? FRANE_DS1_S :
+          kind == FRANE_DS1_PACKED || kind == FRANE_DS1_SPLIT ? 3 : 0;
+}
+static inline bool frane_ds1_ops_valid(frane_ds1_kind kind,
+                                      frane_ds1_ops op,
+                                      frane_ds1_emitted emitted)
+{
+   const uint8_t aspects = frane_ds1_aspects(kind);
+   if (!aspects || !op.known ||
+       ((op.load | op.store | op.clear | op.preserve) & ~aspects) ||
+       (op.load & op.clear) || (op.store & op.preserve))
+      return false;
+   frane_ds1_emitted expected {};
+   expected.clear = op.clear;
+   if (kind == FRANE_DS1_SPLIT) {
+      expected.load = op.load & FRANE_DS1_D;
+      expected.store = op.store & FRANE_DS1_D;
+      expected.load_stencil = op.load & FRANE_DS1_S;
+      expected.store_stencil = op.store & FRANE_DS1_S;
+   } else {
+      expected.load = op.load ||
+         (kind == FRANE_DS1_PACKED && op.store && op.preserve);
+      expected.store = op.store;
+   }
+   return emitted.load == expected.load && emitted.store == expected.store &&
+          emitted.load_stencil == expected.load_stencil &&
+          emitted.store_stencil == expected.store_stencil &&
+          emitted.clear == expected.clear;
+}
+static inline bool frane_ds1_planes_valid(const frane_ds1_plane *planes,
+                                         uint32_t count, uint32_t pixels,
+                                         uint32_t capacity,
+                                         uint32_t alignment)
+{
+   if (!planes || !count || count > 8 || !pixels || !capacity || !alignment)
+      return false;
+   for (uint32_t i = 0; i < count; ++i) {
+      if (planes[i].offset < 0 || !planes[i].cpp ||
+          uint32_t(planes[i].offset) % alignment)
+         return false;
+      const uint64_t begin = uint32_t(planes[i].offset);
+      const uint64_t end = begin + uint64_t(pixels) * planes[i].cpp;
+      if (end > capacity)
+         return false;
+      for (uint32_t j = 0; j < i; ++j) {
+         const uint64_t other_begin = uint32_t(planes[j].offset);
+         const uint64_t other_end = other_begin + uint64_t(pixels) * planes[j].cpp;
+         if (begin < other_end && other_begin < end)
+            return false;
+      }
+   }
+   return true;
+}
+static inline uint32_t frane_ds1_ops_key(uint32_t format, frane_ds1_ops op)
+{
+   return (format & 0xffffu) | (uint32_t(op.load) << 16) |
+          (uint32_t(op.store) << 18) | (uint32_t(op.clear) << 20) |
+          (uint32_t(op.preserve) << 22) | (uint32_t(op.known) << 24);
+}
+static inline bool frane_ds1_frontier_allowed(bool enabled,
+                                             bool smart_owned,
+                                             bool measured,
+                                             uint8_t flags)
+{
+   return !enabled || (!smart_owned && !measured &&
+                       !(flags & FRANE_DS1_HAS_STENCIL));
+}
+#endif
diff --git a/src/freedreno/vulkan/frane_smart_adaptive.h b/src/freedreno/vulkan/frane_smart_adaptive.h
new file mode 100644
--- /dev/null
+++ b/src/freedreno/vulkan/frane_smart_adaptive.h
@@ -0,0 +1,150 @@
+#ifndef FRANE_SMART_ADAPTIVE_H
+#define FRANE_SMART_ADAPTIVE_H
+#include "frane_mesa_26364_a810_smart_v2.h"
+
+struct frane_adaptive_state {
+   frane_26364_state votes {};
+   frane_26358_mode_stats stats[2] {};
+   uint32_t draws[2] {};
+   uint32_t last_sample[2] {};
+   uint32_t anchor_draws = 0;
+   uint8_t spike_streak = 0;
+   uint8_t burst_pairs = 0;
+   bool expensive = false;
+   bool critical = false;
+   bool reversal_confirmed = false;
+};
+
+static inline unsigned frane_adaptive_bank(uint32_t draws)
+{
+   return draws < 64 ? 0 : draws < 256 ? 1 : draws < 1024 ? 2 : 3;
+}
+
+static inline bool frane_adaptive_draws_close(uint32_t a, uint32_t b)
+{
+   const uint64_t low = a < b ? a : b;
+   const uint64_t high = a > b ? a : b;
+   return high <= low + low / 4 + 4;
+}
+
+static inline uint32_t frane_adaptive_draw_code(uint32_t draws)
+{
+   const uint64_t code = (uint64_t(draws) + 15) / 16;
+   return uint32_t(code > 16383 ? 16383 : code);
+}
+
+static inline uint64_t frane_adaptive_cost(uint64_t duration,
+                                          const frane_26358_mode_stats &stats)
+{
+   uint64_t premium = stats.tail > stats.mean ? (stats.tail - stats.mean) / 2 : 0;
+   if (premium > duration / 4) premium = duration / 4;
+   return duration > UINT64_MAX - premium ? UINT64_MAX : duration + premium;
+}
+
+static inline uint64_t frane_adaptive_pack(const frane_adaptive_state &s)
+{
+   uint32_t low = frane_26362_pack_histogram(s.votes.hist) & 0x1fffu;
+   if (!s.votes.hist.preference && s.stats[0].samples && s.stats[1].samples &&
+       frane_adaptive_cost(s.stats[1].mean, s.stats[1]) <
+       frane_adaptive_cost(s.stats[0].mean, s.stats[0])) low |= 3u;
+   low |= uint32_t(s.votes.hist.switches >= 4) << 13;
+   low |= uint32_t(s.reversal_confirmed) << 14;
+   low |= uint32_t(s.critical) << 15;
+   low |= frane_adaptive_draw_code(s.anchor_draws) << 16;
+   low |= uint32_t(s.burst_pairs != 0) << 30;
+   low |= uint32_t(s.expensive) << 31;
+   return (uint64_t(s.votes.last_pair) << 32) | low;
+}
+
+static inline void frane_adaptive_feed(frane_adaptive_state &s, bool sysmem,
+                                      uint64_t duration, uint32_t occurrence,
+                                      uint32_t draws, uint64_t critical_ticks)
+{
+   if (!duration) return;
+   const unsigned mode = sysmem ? 1 : 0;
+   const bool newest = !s.stats[mode].samples ||
+      uint32_t(occurrence - s.last_sample[mode]) < UINT32_C(0x80000000);
+   if (newest) {
+      const bool winner = s.votes.hist.preference ==
+         (sysmem ? FRANE_HIST_PREF_SYSMEM : FRANE_HIST_PREF_GMEM);
+      if (winner && s.stats[mode].samples >= 4 &&
+          !frane_26358_ratio_le(s.stats[mode].mean, duration, 4, 5)) {
+         s.spike_streak = 0;
+      } else if (winner && s.stats[mode].samples >= 4) {
+         if (s.spike_streak < 2) ++s.spike_streak;
+         if (s.spike_streak == 2) s.burst_pairs = 4;
+      }
+      const uint64_t old_tail = s.stats[mode].tail;
+      s.stats[mode] = frane_26358_update_mode(s.stats[mode], duration);
+      if (old_tail && duration < old_tail) {
+         s.stats[mode].tail = frane_26358_step_toward(old_tail, duration, 3);
+         if (s.stats[mode].tail < s.stats[mode].mean)
+            s.stats[mode].tail = s.stats[mode].mean;
+      }
+      s.last_sample[mode] = occurrence;
+   }
+   if ((s.votes.pending & (1u << (mode ^ 1u))) &&
+       !frane_adaptive_draws_close(draws, s.draws[mode ^ 1u]))
+      s.votes.pending = 0;
+   s.draws[mode] = draws;
+   const uint32_t previous_pair = s.votes.last_pair;
+   const uint32_t previous_count = s.votes.hist.observations;
+   const int8_t previous_pref = s.votes.hist.preference;
+   frane_26364_feed(s.votes, sysmem,
+                   frane_adaptive_cost(duration, s.stats[mode]), occurrence);
+   if (s.votes.last_pair == previous_pair &&
+       s.votes.hist.observations == previous_count) return;
+   if (previous_pref && s.votes.hist.preference &&
+       previous_pref != s.votes.hist.preference && s.votes.hist.confidence >= 6)
+      s.reversal_confirmed = true;
+   if (!s.votes.hist.preference) s.reversal_confirmed = false;
+   s.anchor_draws = uint32_t((uint64_t(s.draws[0]) + s.draws[1]) / 2);
+   const uint64_t g = s.votes.cost[0], y = s.votes.cost[1];
+   const uint64_t low = g < y ? g : y, high = g > y ? g : y;
+   s.expensive = low && frane_26358_ratio_le(low, high, 1, 2);
+   s.critical = high >= critical_ticks;
+   if (s.burst_pairs) --s.burst_pairs;
+   if (s.votes.opposite_streak)
+      s.burst_pairs = 4;
+}
+
+static inline frane_26364_decision
+frane_adaptive_select(bool enabled, bool tail_risk, uint64_t word,
+                      uint32_t probability, uint32_t occurrence,
+                      uint64_t hash, uint32_t draws)
+{
+   frane_26364_decision d {};
+   if (!enabled) return d;
+   const uint32_t low = uint32_t(word);
+   const auto h = frane_26362_unpack_histogram(low & 0x1fffu);
+   const uint32_t age = occurrence - uint32_t(word >> 32);
+   const uint32_t anchor = (low >> 16) & 16383u;
+   const uint32_t current = frane_adaptive_draw_code(draws);
+   const bool load_change = anchor &&
+      !frane_adaptive_draws_close(current * 16, anchor * 16);
+   const bool fast = (low & (1u << 30)) || load_change || age > 512;
+   const bool confirmed = (low & (1u << 14)) && h.confidence >= 6;
+   const bool ready = h.preference && age <= 512 && h.confidence >= 4 &&
+      h.recent_observations >= (confirmed ? 1u : tail_risk ? 4u : 2u);
+   const bool balanced = !h.preference && age <= 512 && h.recent_observations >= 4;
+   const bool sys = ready ? h.preference == FRANE_HIST_PREF_SYSMEM :
+      balanced ? (low & 3u) == 3u : probability > 50;
+   uint32_t shift = !ready ? (balanced ? 6 : 3) : fast ? 3 :
+      (low & (1u << 13)) ? 5 :
+      ((low & (1u << 31)) && h.confidence >= 6 ? 8 : tail_risk ? 6 : 7);
+   const uint32_t mask = (1u << shift) - 1;
+   uint32_t slot = (occurrence >> shift) ^ uint32_t(hash) ^ uint32_t(hash >> 32);
+   slot ^= slot >> 16; slot *= UINT32_C(0x7feb352d); slot ^= slot >> 15;
+   slot &= mask;
+   if (slot == mask) --slot;
+   const uint32_t phase = occurrence & mask;
+   const bool first = phase == slot, second = phase == slot + 1;
+   const uint32_t watch_mask = balanced ? 63 : (low & (1u << 15)) || tail_risk ? 15 : 31;
+   const bool watch = ((occurrence + uint32_t(hash >> 32)) & watch_mask) == 0;
+   d.owns = true;
+   d.tier = ready ? uint8_t(fast ? 1 : h.confidence >= 6 ? 3 : 2) : 0;
+   d.sysmem = second ? !sys : sys;
+   d.measure = first || second || watch;
+   return d;
+}
+#endif
