+                        att.format == VK_FORMAT_D32_SFLOAT_S8_UINT ? FRANE_DS1_SPLIT :
+                        att.format == VK_FORMAT_S8_UINT ? FRANE_DS1_STENCIL :
+                        depth && !stencil ? FRANE_DS1_DEPTH : FRANE_DS1_UNKNOWN;
+      frane_ds1_emitted emitted {};
